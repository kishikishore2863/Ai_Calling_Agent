FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra speech --no-install-project --python python3.11
COPY services ./services
CMD ["uv", "run", "--no-sync", "uvicorn", "services.speech.server:app", "--host", "0.0.0.0", "--port", "8001"]
