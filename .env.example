# ---------- LiveKit ----------
# Local dev:  `livekit-server --dev` uses devkey / secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------- Telephony (needed only for real phone calls) ----------
SIP_TRUNK_ADDRESS=
SIP_TRUNK_NUMBER=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_OUTBOUND_TRUNK_ID=          # printed by scripts/setup_trunk.py
TRANSFER_PHONE_NUMBER=          # optional, human rep for warm transfer, E.164

# ---------- LLM (OpenAI-compatible) ----------
# Mac dev (Ollama):   http://localhost:11434/v1   qwen2.5:3b
# GPU box (vLLM):     http://<gpu-host>:8000/v1   Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=not-needed

# ---------- Speech server (STT + TTS) ----------
SPEECH_BASE_URL=http://localhost:8001/v1
STT_LANGUAGE=en
TTS_VOICE=af_heart
WHISPER_MODEL=base.en           # GPU: large-v3-turbo (+ WHISPER_COMPUTE_TYPE=float16)
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ---------- Agent ----------
AGENT_NAME=outbound-caller
AGENT_PROFILE=default
